<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1D"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Status Bar: System Diagnostics -->
    <TextView
        android:id="@+id/tvStatusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="[ULTRON SYSTEM: ONLINE] | NEURAL LINK: STABLE"
        android:textColor="#00E5FF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <!-- Center HUD: Iron Man Animated AI Visualizer / Core Head -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_gravity="center"
        android:background="#111927"
        android:layout_marginVertical="10dp">

        <!-- Placeholder for Iron Man Head / Talking HUD Animation -->
        <ImageView
            android:id="@+id/ivAiAvatar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:src="@android:ic_menu_compass"
            android:tint="#00E5FF"
            android:contentDescription="ULTRON AI Core" />

        <!-- Holographic Scanner Lines Effect -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:text="-- JARVIS / ULTRON HUD CORE --"
            android:textColor="#FF3D00"
            android:textSize="10sp" />
    </FrameLayout>

    <!-- Center Console Log Window -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#121826"
        android:padding="8dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tvConsoleLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="> Initializing ULTRON Subsystems...\n"
            android:textColor="#00FF66"
            android:textSize="14sp"
            android:fontFamily="monospace" />
    </ScrollView>

    <!-- Bottom Command Input & Execute Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etCommandInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Enter directive or trade protocol..."
            android:textColor="#FFFFFF"
            android:textColorHint="#78909C"
            android:backgroundTint="#00E5FF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnExecute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXECUTE"
            android:backgroundTint="#00E5FF"
            android:textColor="#0A0F1D"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
