<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050B14"
    android:padding="16dp">

    <!-- Header Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ULTRON SUPER AI // HUD v1.0"
        android:textColor="#00E5FF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp" />

    <!-- Core Status Box -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_below="@id/tvTitle"
        android:layout_marginTop="30dp"
        android:background="#0A192F"
        android:padding="12dp"
        android:text="[ SYSTEM ONLINE ]\nWaiting for BOSS command..."
        android:textColor="#64FFDA"
        android:textSize="14sp"
        android:fontFamily="monospace" />

    <!-- Command Input Box -->
    <EditText
        android:id="@+id/etCommand"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_above="@id/btnExecute"
        android:layout_marginBottom="15dp"
        android:background="#0A192F"
        android:hint="> ENTER COMMAND..."
        android:textColorHint="#4A5568"
        android:textColor="#00E5FF"
        android:paddingHorizontal="12dp" />

    <!-- Execute Button -->
    <Button
        android:id="@+id/btnExecute"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="30dp"
        android:backgroundTint="#00E5FF"
        android:text="INITIALIZE ULTRON"
        android:textColor="#050B14"
        android:textSize="16sp"
        android:textStyle="bold" />

</RelativeLayout>
