<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060913"
    android:padding="16dp">

    <!-- Top Header -->
    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:text="ULTRON SUPER AI - SUPREME MODE"
        android:textColor="#00FFCC"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"/>

    <!-- Core Assistant & Real-time Output Box -->
    <LinearLayout
        android:id="@+id/assistantBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerTitle"
        android:layout_marginTop="20dp"
        android:background="#121C2E"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ ULTRON Live Analysis & Execution Core ]"
            android:textColor="#00BFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/ultronSpeech"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            text="আসসালামু আলাইকুম, বস! আমি প্রস্তুত। YouTube গান চালানো, WhatsApp মেসেজ পাঠানো, Google সার্চ বা অ্যাপ ইনস্টল—সব হুকুম পালন করতে আমি রেডি।"
            android:textColor="#FFFFFF"
            android:textSize="15sp"/>
    </LinearLayout>

    <!-- System Status Monitor -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/assistantBox"
        android:layout_marginTop="15dp"
        android:background="#0D1322"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            text="64 SYSTEMS & 100 TRADING BRAINS: Active & Monitoring"
            android:textColor="#00FF66"
            android:textSize="12sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            text="STEALTH MODE & VOICE ENGINE: Online"
            android:textColor="#00BFFF"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Bottom Voice & Action Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <ImageView
            android:id="@+id/micButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="#00FFCC"
            android:padding="16dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:elevation="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            text="মাইক্রোফোনে ক্লিক করে হুকুম দিন, বস!"
            android:textColor="#8A99AD"
            android:textSize="12sp"/>
    </LinearLayout>

</RelativeLayout>
